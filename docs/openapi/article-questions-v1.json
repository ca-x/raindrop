{
  "openapi": "3.1.0",
  "info": { "title": "Raindrop article questions", "version": "1.0.0" },
  "paths": {
    "/api/v1/entries/{entryId}/ai/questions": {
      "post": {
        "summary": "Ask a question about an owned article and its completed summary",
        "description": "Session authentication and CSRF are required. The server loads article and summary context, uses the configured summary Provider through the official native runtime, and returns a complete answer. History is bounded and is not persisted by this endpoint.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArticleQuestionRequest" } } } },
        "responses": { "200": { "description": "Complete answer", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArticleQuestionResponse" } } } } }
      }
    }
  },
  "components": {
    "schemas": {
      "QuestionTurn": {
        "type": "object", "additionalProperties": false,
        "required": ["question", "answer"],
        "properties": {
          "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "answer": { "type": "string", "minLength": 1, "maxLength": 16000 }
        }
      },
      "ArticleQuestionRequest": {
        "type": "object", "additionalProperties": false,
        "required": ["summaryJobId", "question", "responseLocale", "history"],
        "properties": {
          "summaryJobId": { "type": "string", "format": "uuid" },
          "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "responseLocale": { "type": "string", "minLength": 2, "maxLength": 35 },
          "history": { "type": "array", "maxItems": 8, "items": { "$ref": "#/components/schemas/QuestionTurn" } }
        }
      },
      "ArticleQuestionResponse": {
        "type": "object", "additionalProperties": false,
        "required": ["answerMarkdown", "providerLabel"],
        "properties": {
          "answerMarkdown": { "type": "string", "minLength": 1, "maxLength": 16000 },
          "providerLabel": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    }
  }
}
